# Copy this file to .env or set these variables in your hosting service.

BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Your Telegram channel ID, usually something like -1001234567890
CHANNEL_ID=-1001234567890

# Telegram user IDs allowed to use admin commands.
# Separate multiple IDs with commas.
ADMIN_IDS=123456789

# Optional
DATABASE=movies.db
